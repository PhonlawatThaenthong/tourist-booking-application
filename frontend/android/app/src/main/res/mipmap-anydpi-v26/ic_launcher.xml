<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ launcher icon: the resort logo on white. The launcher crops
     the foreground to its own shape (circle, squircle, ...), so the logo in
     ic_launcher_foreground.png is drawn small enough to survive any of them. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
