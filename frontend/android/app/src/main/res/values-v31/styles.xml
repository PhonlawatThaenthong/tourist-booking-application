<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash (icon in a circle on a
         flat colour) and does not draw windowBackground during launch. Point
         it at the resort logo on white. splash_icon is a 240dp canvas with the
         logo at 156dp, inside the 160dp circle the system keeps visible. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
